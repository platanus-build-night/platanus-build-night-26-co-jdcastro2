# Sin barra final a propósito: los worktrees lo tienen como SYMLINK, y
# "node_modules/" solo matchea directorios de verdad — el symlink se colaría.
node_modules
.env
runs/*
!runs/demo/
.DS_Store
*.log
web/
.vercel
.env*

# Exports de conversaciones: son mensajes REALES de clientas y el repo es
# publico. data/ esta versionado por category-benchmarks.json, asi que los
# CSV se excluyen uno a uno en vez de ignorar la carpeta.
data/*.csv
data/*.txt
