# La key del evento. Copia este archivo a .env y pega la key.
ANTHROPIC_API_KEY=sk-ant-...

# Modelos. El de juicio es configurable a propósito:
#  - fable-5 EXIGE retención de datos de 30 días. Si la org de la key está en
#    zero-data-retention, TODA llamada a fable da 400 → cambia a claude-opus-5.
#  - haiku-4-5 no acepta output_config.effort (llm.ts ya lo omite por él).
DARWIN_JUDGE_MODEL=claude-fable-5
DARWIN_VOLUME_MODEL=claude-haiku-4-5

# Freno de mano: la corrida entera aborta al llegar aquí (USD).
DARWIN_HARD_STOP=4

# Puerto del war room
PORT=3000

# ── Supabase (backend real) ──
# El worker escribe con service_role; el navegador lee con la publicable.
SUPABASE_URL=https://ezozlvywdihxdwwbtyql.supabase.co
# SECRETA. Dashboard → Project Settings → API Keys → service_role.
# Solo la usa src/worker.ts. JAMÁS va al navegador ni al build de web/.
SUPABASE_SERVICE_ROLE_KEY=
